---
import { pageHref } from "../../lib/site-url";
import SiteIcon from "./SiteIcon.astro";
interface Props { whatsAppUrl?: string; }
const { whatsAppUrl } = Astro.props;
---
<a class="floating-contact" data-floating-contact href={pageHref(whatsAppUrl || "/consultation")} target={whatsAppUrl ? "_blank" : undefined} rel={whatsAppUrl ? "noopener noreferrer" : undefined} hidden>
  <SiteIcon name="message" /><span>{whatsAppUrl ? "Chat on WhatsApp" : "Ask about care"}</span>
</a>
<script>
  const contact = document.querySelector<HTMLElement>("[data-floating-contact]");
  const footer = document.getElementById("site-footer");
  if (contact && footer && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(([entry]) => {
      contact.hidden = entry.isIntersecting;
    }, { rootMargin: "0px 0px 12px 0px" });
    observer.observe(footer);
  }
</script>
<style>
  .floating-contact { position: fixed; z-index: 20; right: max(1.5rem, env(safe-area-inset-right)); bottom: max(1.5rem, env(safe-area-inset-bottom)); display: inline-flex; align-items: center; justify-content: center; gap: .65rem; min-height: 3.5rem; padding: .85rem 1.1rem; border-radius: 100vmax; background: #177741; color: white; box-shadow: 0 5px 14px rgb(16 24 34 / .24); font-size: 1rem; font-weight: 650; text-decoration: none; }
  .floating-contact[hidden] { display: none; }
  .floating-contact:hover { background: #116237; }
  @media (max-width: 47.99rem) { .floating-contact { right: 1rem; bottom: max(1rem, env(safe-area-inset-bottom)); } }
</style>
