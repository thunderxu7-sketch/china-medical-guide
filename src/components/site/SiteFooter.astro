---
import SiteIcon from "./SiteIcon.astro";
interface Props { whatsAppUrl?: string; }
const { whatsAppUrl } = Astro.props;
const year = new Date().getUTCFullYear();
---
<footer class="site-footer" id="site-footer">
  <div class="site-container">
    <div class="footer-columns">
      <div>
        <h2>China Medical Guide</h2>
        <p>An English-language guide to medical services in China, with information for patients and the people travelling with them.</p>
      </div>
      <nav aria-label="Quick links">
        <h2>Quick Links</h2>
        <ul>
          <li><a href="/services">Medical services</a></li>
          <li><a href="/about">About the guide</a></li>
          <li><a href="/consultation">Request a consultation</a></li>
        </ul>
      </nav>
      <nav aria-label="Featured services">
        <h2>Services</h2>
        <ul>
          <li><a href="/services/hip-replacement">Orthopedic surgery</a></li>
          <li><a href="/services/cataract-treatment">Eye care</a></li>
          <li><a href="/services/cardiac-surgery">Cardiac surgery</a></li>
          <li><a href="/services/remote-consultation">Remote TCM consultation</a></li>
        </ul>
      </nav>
      <nav aria-label="Patient support">
        <h2>Patient Support</h2>
        <ul class="support-list">
          <li><SiteIcon name="mail" size={17} /><a href="/consultation">Contact the team</a></li>
          <li><SiteIcon name="map" size={17} /><a href="/travel">Travel &amp; support</a></li>
          {whatsAppUrl && <li><SiteIcon name="message" size={17} /><a href={whatsAppUrl} target="_blank" rel="noopener noreferrer">Chat on WhatsApp</a></li>}
        </ul>
      </nav>
    </div>
    <div class="footer-legal">
      <p>© {year} China Medical Guide.</p>
      <nav aria-label="Policies"><a href="/privacy">Privacy Policy</a><a href="/terms">Terms of Service</a></nav>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--primary); color: #f5f8fc; padding-block: 3rem; }
  .footer-columns { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2rem; padding-bottom: 2rem; }
  h2 { margin: 0 0 1rem; color: #fff; font-size: 1rem; font-weight: 650; }
  .footer-columns > div h2 { font-size: 1.125rem; font-weight: 700; }
  p, ul, .footer-legal { font-size: .875rem; line-height: 1.65; }
  .footer-columns p { max-width: 30ch; color: #e0e8f3; }
  ul { display: grid; gap: .35rem; list-style: none; margin: 0; padding: 0; }
  a { color: inherit; text-decoration: none; }
  a:hover { text-decoration: underline; text-underline-offset: .22em; }
  .support-list li { display: flex; gap: .55rem; align-items: center; }
  .footer-legal { border-top: 1px solid rgb(255 255 255 / .23); display: flex; gap: 1rem; align-items: center; justify-content: space-between; padding-top: 2rem; color: #e0e8f3; }
  .footer-legal nav { display: flex; gap: 1.5rem; }
  @media (max-width: 47.99rem) {
    .footer-columns { grid-template-columns: 1fr; gap: 1.75rem; }
    .footer-columns p { max-width: 50ch; }
    .footer-legal { flex-direction: column; align-items: flex-start; }
  }
</style>
