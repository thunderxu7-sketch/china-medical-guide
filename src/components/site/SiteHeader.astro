---
import SiteIcon from "./SiteIcon.astro";

const links = [
  { href: "/", label: "Home" },
  { href: "/services", label: "Services" },
  { href: "/doctors", label: "Expert Specialists" },
  { href: "/testimonials", label: "Patient Stories" },
  { href: "/faq", label: "FAQ" },
  { href: "/about", label: "About Us" },
  { href: "/travel", label: "Travel & Support" },
];
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
function currentPage(href: string) {
  if (currentPath === href) return "page";
  return href !== "/" && currentPath.startsWith(href + "/") ? "location" : undefined;
}
---
<header class="masthead">
  <div class="site-container masthead-inner">
    <a class="brand" href="/" aria-label="China Medical Guide home">
      <span class="brand-mark" aria-hidden="true"><span>+</span></span>
      <span class="brand-name">China Medical Guide</span>
    </a>

    <nav class="desktop-nav" aria-label="Main navigation">
      {links.map(({ href, label }) => <a href={href} aria-current={currentPage(href)}>{label}</a>)}
    </nav>
    <a class="site-button header-cta" href="/consultation" aria-current={currentPage("/consultation")}>Get Consultation</a>

    <details class="mobile-menu" data-site-menu>
      <summary>
        <span class="when-closed"><SiteIcon name="menu" /><span class="sr-only">Open navigation</span></span>
        <span class="when-open"><SiteIcon name="close" /><span class="sr-only">Close navigation</span></span>
      </summary>
      <nav aria-label="Mobile navigation" class="mobile-panel">
        {links.map(({ href, label }) => <a href={href} aria-current={currentPage(href)}>{label}</a>)}
        <a class="site-button" href="/consultation" aria-current={currentPage("/consultation")}>Get Consultation</a>
      </nav>
    </details>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>("[data-site-menu]");
  if (menu) {
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        menu.open = false;
        menu.querySelector("summary")?.focus();
      }
    });
    document.addEventListener("click", (event) => {
      if (menu.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
  }
</script>

<style>
  .masthead { position: sticky; top: 0; z-index: 30; border-bottom: 1px solid var(--border); background: var(--background); box-shadow: 0 1px 3px rgb(15 23 42 / .1); }
  .masthead-inner { display: flex; align-items: center; justify-content: space-between; height: 4rem; gap: 1rem; }
  .brand { display: inline-flex; align-items: center; gap: .5rem; color: var(--primary); font-size: 1.25rem; font-weight: 750; letter-spacing: -.035em; white-space: nowrap; text-decoration: none; }
  .brand-mark { width: 2.5rem; height: 2.5rem; position: relative; display: grid; place-items: center; background: white; border-radius: .25rem; }
  .brand-mark::before { content: ""; position: absolute; inset: .42rem; border: .23rem solid var(--primary); border-right-color: transparent; border-radius: 50%; transform: rotate(-22deg); }
  .brand-mark span { color: var(--secondary); font: 800 1.82rem/.9 system-ui, sans-serif; transform: translate(.19rem, -.02rem); }
  .brand:hover { opacity: .82; }
  .desktop-nav { display: flex; align-items: center; gap: .1rem; }
  .desktop-nav a, .mobile-panel > a:not(.site-button) { padding: .5rem .72rem; color: var(--foreground); font-size: .875rem; line-height: 1.5; font-weight: 550; text-decoration: none; white-space: nowrap; }
  .desktop-nav a { border-block: 2px solid transparent; }
  .desktop-nav a[aria-current] { border-bottom-color: var(--primary); color: var(--primary); }
  .desktop-nav a:hover, .mobile-panel > a:not(.site-button):hover { color: var(--primary); border-radius: .4rem; background: color-mix(in srgb, var(--secondary) 10%, transparent); }
  .header-cta { flex: none; }
  .mobile-menu { display: none; }
  .mobile-menu summary { display: flex; align-items: center; justify-content: center; width: 2.75rem; height: 2.75rem; cursor: pointer; list-style: none; border-radius: .5rem; }
  .mobile-menu summary::-webkit-details-marker { display: none; }
  .mobile-menu summary span { align-items: center; justify-content: center; }
  .when-open, [open] .when-closed { display: none; }
  .when-closed, [open] .when-open { display: flex; }
  .mobile-panel { position: absolute; inset: calc(100% + 1px) 0 auto; display: grid; gap: .25rem; max-height: calc(100vh - 4rem); max-height: calc(100dvh - 4rem); padding: .75rem max(1rem, calc((100vw - 76rem) / 2)) 1rem; overflow: auto; background: var(--background); box-shadow: 0 .5rem .75rem rgb(15 23 42 / .12); }
  .mobile-panel a[aria-current]:not(.site-button) { background: color-mix(in srgb, var(--secondary) 10%, transparent); color: var(--primary); }
  .mobile-panel .site-button { margin: .4rem .72rem 0; }
  @media (max-width: 70rem) {
    .desktop-nav, .header-cta { display: none; }
    .mobile-menu { display: block; }
  }
  @media (max-width: 39.99rem) { .brand-name { display: none; } }
</style>
