---
import { pageHref } from "../../lib/site-url";
import { emailEnabled } from "../../components/site/contact";
interface Props {
  href: string;
  title: string;
  description: string;
  action: string;
}
const { href, title, description, action } = Astro.props;
---
<section class="svc-cta">
  <div class="svc-container">
    <h2>{title}</h2>
    <p>{emailEnabled ? description : "Use the consultation guide to review treatment costs, visit arrangements and questions to discuss with your provider."}</p>
    <a class="svc-cta-action" href={pageHref(href)}>{emailEnabled ? action : "Plan your consultation"}</a>
  </div>
</section>
