---
import { pageHref } from "../../lib/site-url";
import { emailEnabled } from "../../components/site/contact";
interface Props {
  title: string;
  description: string;
  label: string;
  light?: boolean;
}
const { title, description, label, light = false } = Astro.props;
---
<section class:list={["info-contact", { "info-contact--light": light }]}>
  <div class="info-narrow">
    <h2>{title}</h2>
    <p>{emailEnabled ? description : "Choose a service to review costs and find questions to take to your provider."}</p>
    <a class="info-button" href={pageHref("/consultation")}>{emailEnabled ? label : "Open the consultation guide"}</a>
  </div>
</section>
