---
import { pageHref } from "../lib/site-url";
import InformationPage from "../features/information/InformationPage.astro";
---
<InformationPage title="Page not found" summary="This address doesn’t lead to a page in China Medical Guide. You can find a treatment in the service directory or return to the home page.">
  <div class="info-section info-wrap">
    <a class="site-button" href={pageHref("/services")}>Browse services</a>
    <a class="return-home" href={pageHref("/")}>Return home</a>
  </div>
</InformationPage>

<style>
  .return-home { margin-inline-start: 1.25rem; color: var(--primary); text-decoration: underline; }
</style>
