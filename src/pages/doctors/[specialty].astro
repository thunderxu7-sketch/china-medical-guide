---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { specialties, type Specialty } from "../../features/specialists/data";
import PeopleIcon from "../../features/specialists/PeopleIcon.astro";
import { services } from "../../data/services";
import "../../features/specialists/people.css";

export function getStaticPaths() {
  return specialties.map((specialty) => ({ params: { specialty: specialty.slug }, props: { specialty } }));
}
interface Props { specialty: Specialty; }
const { specialty } = Astro.props;
const clinician = specialty.clinician;
const title = clinician?.name ?? specialty.title + " Guide";
---
<BaseLayout title={title + " | China Medical Guide"} description={specialty.summary}>
  <section class="people-hero">
    <div class="people-container">
      <a class="people-back" href="/doctors">Back to specialists</a>
      <div class="people-profile">
        <span class="people-avatar"><PeopleIcon name="person" size={58} /></span>
        <div>
          <h1>{title}</h1>
          <p class="people-profile-field">{specialty.field}</p>
          {clinician ? (
            <div class="people-clinician">
              {clinician.role && <p>{clinician.role}</p>}
              {clinician.institution && <p>{clinician.institution}</p>}
              <a class="people-text-link" href={clinician.source.url}>{clinician.source.label}</a>
            </div>
          ) : <p>{specialty.summary}</p>}
          <a class="site-button" href="/consultation">Request a consultation</a>
        </div>
      </div>
    </div>
  </section>
  <section class="people-band">
    <div class="people-container">
      <h2 class="people-heading">About This Specialty</h2>
      <p class="people-lead">{specialty.overview}</p>
    </div>
  </section>
  <section class="people-band people-band-muted">
    <div class="people-container people-pair">
      <div>
        <h2 class="people-heading"><PeopleIcon name="book" /> What to Prepare</h2>
        <dl class="people-records">
          {specialty.preparation.map((item) => <div><dt>{item.title}</dt><dd>{item.description}</dd></div>)}
        </dl>
      </div>
      <div>
        <h2 class="people-heading"><PeopleIcon name="clipboard" /> Questions for the Clinic</h2>
        <ul class="people-questions">
          {specialty.questions.map((question) => <li><PeopleIcon name="check" size={19} /><span>{question}</span></li>)}
        </ul>
      </div>
    </div>
  </section>
  <section class="people-band">
    <div class="people-container people-pair">
      <div>
        <h2 class="people-heading">Related Services</h2>
        <ul class="people-tags">
          {specialty.services.map((slug) => <li><a href={`/services/${slug}`}>{services.find((entry) => entry.slug === slug)?.name}</a></li>)}
        </ul>
      </div>
      <div>
        <h2 class="people-heading">Planning the Journey</h2>
        <p class="people-copy">{specialty.travel}</p>
        <a class="people-text-link" href="/travel">Explore travel support</a>
      </div>
    </div>
  </section>
  <section class="people-band people-cta">
    <div class="people-container">
      <h2>Ask About Your Appointment</h2>
      <p>Contact the team to ask which clinician and hospital would review your request.</p>
      <a class="site-button site-button--secondary" href="/consultation">Request a consultation</a>
    </div>
  </section>
</BaseLayout>
