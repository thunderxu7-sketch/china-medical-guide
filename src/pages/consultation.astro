---
import BaseLayout from "../layouts/BaseLayout.astro";
import { consultationEndpoint } from "../contracts/consultations";
import { services } from "../data/services";
import { countries } from "../features/consultation-form/countries";
import "../features/consultation-form/consultation.css";

const number = import.meta.env.PUBLIC_WHATSAPP_NUMBER?.trim();
const whatsAppUrl = number && /^[1-9]\d{6,14}$/.test(number) ? `https://wa.me/${number}` : undefined;
const categories = {
  surgery: "Surgical procedures",
  ophthalmology: "Ophthalmology",
  orthopedics: "Orthopedic care",
  tcm: "Traditional Chinese medicine",
};
---

<BaseLayout
  title="Request a Free Consultation | China Medical Guide"
  description="Choose a service and contact China Medical Guide with questions about treatment costs, appointments and travel to China."
>
  <div class="consult-page">
    <section class="consult-hero" aria-labelledby="consult-title">
      <div class="consult-width">
        <h1 id="consult-title">Request a Free Consultation</h1>
        <p class="consult-intro">Tell us which service you’re considering and ask about pricing, appointment options, or travel arrangements.</p>
        <p class="consult-shortcut">
          {whatsAppUrl
            ? <>Prefer to chat? <a href={whatsAppUrl}>Contact us on WhatsApp</a> about your visit.</>
            : <>Planning your visit? <a href="/travel">Explore travel support</a> before sending your inquiry.</>}
        </p>
      </div>
    </section>

    <div class="consult-width consult-content">
      <section class="consult-card consult-form-card" aria-labelledby="form-heading">
        <h2 id="form-heading">Consultation Form</h2>
        <form id="consultation-form" action={consultationEndpoint} method="post" aria-labelledby="form-heading">
          <fieldset>
            <div class="consult-field">
              <label for="consult-name">Full name <span aria-hidden="true">*</span></label>
              <input id="consult-name" name="name" type="text" autocomplete="name" maxlength="120" pattern=".*\S.*" required placeholder="Your full name" />
            </div>
            <div class="consult-field">
              <label for="consult-email">Email address <span aria-hidden="true">*</span></label>
              <input id="consult-email" name="email" type="email" autocomplete="email" maxlength="254" pattern={String.raw`[^@\s]+@[^@\s]+\.[^@\s]+`} required placeholder="you@example.com" />
            </div>
            <div class="consult-field">
              <label for="consult-phone">Phone number <span aria-hidden="true">*</span></label>
              <input id="consult-phone" name="phone" type="tel" autocomplete="tel" maxlength="64" pattern=".*\S.*" required placeholder="Include your country code" />
            </div>
            <div class="consult-field">
              <label for="consult-country">Country or region <span aria-hidden="true">*</span></label>
              <span class="consult-select">
                <select id="consult-country" name="country" autocomplete="country-name" required>
                  <option value="">Select your country</option>
                  {countries.map((country) => <option value={country}>{country}</option>)}
                </select>
              </span>
            </div>
            <div class="consult-field">
              <label for="consult-service">Service of interest <span aria-hidden="true">*</span></label>
              <span class="consult-select">
                <select id="consult-service" name="service" required>
                  <option value="">Select a service</option>
                  {Object.entries(categories).map(([category, label]) => (
                    <optgroup label={label}>
                      {services.filter((item) => item.category === category).map((item) => (
                        <option value={item.slug}>{item.name}</option>
                      ))}
                    </optgroup>
                  ))}
                </select>
              </span>
            </div>
            <div class="consult-field">
              <label for="consult-message">Additional information</label>
              <textarea id="consult-message" name="message" rows="2" maxlength="4000" placeholder="What would you like to know about your visit?"></textarea>
            </div>
            <p class="consult-privacy">We’ll use these details to reply to your inquiry. <a href="/privacy">Privacy policy</a></p>
            <button class="consult-submit" type="submit" disabled>Send consultation request</button>
          </fieldset>
          <noscript><p class="consult-notice">Enable JavaScript to send a consultation request.</p></noscript>
          <p class="consult-feedback" data-feedback role="status" aria-live="polite" aria-atomic="true"></p>
          {whatsAppUrl && <p class="consult-alternate" data-alternate-contact hidden><a href={whatsAppUrl}>Contact us on WhatsApp</a></p>}
        </form>
      </section>

      <aside class="consult-card consult-contacts" aria-labelledby="contact-heading">
        <h2 id="contact-heading">Quick Contact</h2>
        <div class="consult-contacts-list">
          {whatsAppUrl && (
            <div class="consult-contact">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20.5 11.7a8.4 8.4 0 0 1-8.5 8.4 9 9 0 0 1-3.6-.8L3.2 21l1.6-5a8.4 8.4 0 1 1 15.7-4.3Z" /></svg>
              <div><h3>WhatsApp</h3><a class="consult-whatsapp" href={whatsAppUrl}>Chat on WhatsApp</a></div>
            </div>
          )}
          <div class="consult-contact">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m3 6 9 6 9-6" /></svg>
            <div><h3>Email inquiry</h3><a href="#consult-name">Use the consultation form</a></div>
          </div>
          {!whatsAppUrl && (
            <div class="consult-contact">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M9.4 9a2.7 2.7 0 1 1 4.2 2.3c-1 .6-1.6 1.1-1.6 2.7m0 2.5h.01" stroke-linecap="round" /></svg>
              <div><h3>Common questions</h3><a href="/faq">Visit the FAQ</a></div>
            </div>
          )}
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  import "../features/consultation-form/form";
</script>
